powershell -command "Get-NetTCPConnection -State Established | ForEach-Object { $proc = Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue; $processPath = $proc.Path; $processName = if ($processPath) { [System.IO.Path]::GetFileName($processPath) } else { $proc.ProcessName }; $ownerInfo = (Get-WmiObject Win32_Process -Filter \"ProcessId = $($_.OwningProcess)\").GetOwner(); $user = if ($ownerInfo.Domain -and $ownerInfo.User) { \"$($ownerInfo.Domain)\$($ownerInfo.User)\" } elseif ($ownerInfo.User) { $ownerInfo.User } else { \"SYSTEM\" }; [PSCustomObject]@{ LocalAddress=$_.LocalAddress; LocalPort=$_.LocalPort; RemoteAddress=$_.RemoteAddress; RemotePort=$_.RemotePort; PID=$_.OwningProcess; ProcessName=$processName; User=$user } } | Format-Table -AutoSize"